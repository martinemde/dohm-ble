{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>martinemde/renovate-config#v1.1.0"
  ],
  "enabledManagers": [
    "pep621",
    "github-actions",
    "renovate-config"
  ],
  "includePaths": [
    "pyproject.toml",
    "uv.lock",
    ".github/workflows/validate.yml",
    "renovate.json"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "renovate-config"
      ],
      "automerge": false
    }
  ]
}
